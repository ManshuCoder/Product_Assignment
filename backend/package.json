{
  "name": "producthub-api",
  "version": "1.0.0",
  "description": "Product Management API with JWT authentication",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node -e \"(async()=>{try{await require('kill-port')(5000)}catch(e){} })()\" && nodemon --signal SIGTERM src/server.js",
    "test": "jest --coverage --forceExit",
    "test:watch": "jest --watch",
    "seed": "node src/scripts/seed.js"
  },
  "keywords": [
    "express",
    "mongodb",
    "jwt",
    "products"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clerk/express": "^2.1.23",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.2.0",
    "mongoose": "^8.24.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.2",
    "nodemon": "^3.1.7",
    "kill-port": "^1.6.1",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "testTimeout": 30000
  }
}
