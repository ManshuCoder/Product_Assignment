# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas: replace placeholders below. If your password contains special characters, URL-encode them (e.g. @ -> %40).
# Example: mongodb+srv://dbuser:pass%40word@cluster0.xxxxx.mongodb.net/mydb?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_HOST>/<DB_NAME>?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d

# Client / API (comma-separated; use https://*.vercel.app for Vercel preview URLs)
CLIENT_URL=http://localhost:5174
CLIENT_URLS=http://localhost:5174,https://your-app.vercel.app,https://*.vercel.app
API_URL=http://localhost:5000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Clerk (or other third-party) secrets: set in your hosting provider's secret manager, not in code
CLERK_SECRET_KEY=your_clerk_secret_key_here
